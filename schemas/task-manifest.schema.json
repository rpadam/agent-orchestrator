{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent-orchestrator/task-manifest.schema.json",
  "title": "Agent Task Manifest",
  "type": "object",
  "required": [
    "project",
    "tasks"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "root"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      }
    },
    "model_policy_file": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "prompt_file",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "prompt_file": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "blocked",
              "completed"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "can_run_parallel": {
            "type": "boolean"
          },
          "preferred_tier": {
            "type": "string"
          },
          "preferred_model": {
            "type": "string"
          },
          "review_model": {
            "type": "string"
          },
          "token_estimate": {
            "type": "object",
            "properties": {
              "input_tokens_estimate_min": {
                "type": "integer",
                "minimum": 0
              },
              "input_tokens_estimate_max": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens_estimate_min": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens_estimate_max": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "estimation_notes": {
                "type": "string"
              }
            }
          },
          "completion_usage": {
            "type": "object",
            "properties": {
              "model_requested": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_actual": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "input_tokens_actual": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens_actual": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens_actual": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cost_actual_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "usage_notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "plan_creation": {
      "type": "object",
      "properties": {
        "planner_agent_role": {
          "type": "string"
        },
        "planner_agent_label": {
          "type": "string"
        },
        "planner_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "planner_model_requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "planner_model_actual": {
          "type": [
            "string",
            "null"
          ]
        },
        "planner_input_tokens_actual": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "planner_output_tokens_actual": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "planner_total_tokens_actual": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "planner_cost_actual_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "plan_created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "planning_usage_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
