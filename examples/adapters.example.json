{
  "adapters": [
    {
      "name": "codex",
      "default_profile": "medium",
      "profiles": {
        "cheap": {
          "model": "gpt-5-mini",
          "command": ["codex", "run", "--cwd", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        },
        "medium": {
          "model": "gpt-5-codex",
          "command": ["codex", "run", "--cwd", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        },
        "high": {
          "model": "gpt-5.4",
          "command": ["codex", "run", "--cwd", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        }
      }
    },
    {
      "name": "claude-code",
      "default_profile": "medium",
      "profiles": {
        "cheap": {
          "model": "sonnet",
          "command": ["claude", "code", "--cwd", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        },
        "medium": {
          "model": "sonnet",
          "command": ["claude", "code", "--cwd", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        },
        "high": {
          "model": "opus",
          "command": ["claude", "code", "--cwd", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        }
      }
    },
    {
      "name": "cursor",
      "default_profile": "medium",
      "profiles": {
        "medium": {
          "model": "default",
          "command": ["cursor-agent", "--project", "{project}", "--model", "{model}", "--prompt-file", "{prompt_file}"]
        }
      }
    }
  ]
}
